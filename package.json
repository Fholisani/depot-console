{
  "name": "depot-console",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:deployed": "ng serve --proxy-config proxy.deployed.conf.json",
    "start:passive": "ng serve --proxy-config proxy.passive.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "contract:sync": "cp ../depot/web/src/main/resources/contracts/depot.yaml contracts/depot.yaml && npm run api:types",
    "api:types": "npx -y -p typescript@5 -p openapi-typescript@7 openapi-typescript contracts/depot.yaml -o src/app/core/api/schema.d.ts",
    "api:check": "npm run api:types && git diff --exit-code -- src/app/core/api/schema.d.ts"
  },
  "private": true,
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@ionic/angular": "^9.0.11",
    "angular-auth-oidc-client": "^22.0.2",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
